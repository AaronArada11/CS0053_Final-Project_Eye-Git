{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build library application",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/Library_System_Eye-Git.cpp",
                "${workspaceFolder}/Book.cpp",
                "${workspaceFolder}/InputValidator.cpp",
                "${workspaceFolder}/FileHandler.cpp",
                "${workspaceFolder}/LibraryLogic.cpp",
                "-o",
                "${workspaceFolder}/library.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the menu and its supporting modules."
        }
    ],
    "version": "2.0.0"
}
